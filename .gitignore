# Environment files & secrets
.env
.env.local
.env.*
!.env.example
**/.env
**/.env.local
**/.env.*
!**/.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
